---

# ------------------------------------------------------------------------------
# File        : ctlabs-ansible/playbooks/setup_ctl.yml
# Description : ctlabs phase 3 - write local facts (generated by lab.rb)
# ------------------------------------------------------------------------------
# This is the template Controller->Ansible generates setup_ctl.yml from.
# Edit it directly - it is the single source of truth for everything static.
# The generated per-profile facts plays are spliced in at the PLAYS
# placeholder below on every playbook run; nothing else is touched.
#
# NOTE: unlike a lab this is scoped to the `controller` inventory group
# (ctl-ctrl only), not `all:!rhosts` - ctl-sw0 and ctl-ro0 have no SSH
# authentication set up yet (labs get their keys copied during
# labs-up-container), so Gathering Facts on them would fail UNREACHABLE.
# Widen it once keys are distributed.
# ------------------------------------------------------------------------------

- name : ctlabs.playbooks.setup
  hosts: controller
  tags : setup
  tasks:
    - name: ctlabs.playbooks.setup.facts_dir.linux
      when: ansible_shell_type | default('sh') != 'powershell'
      file:
        path : "{{ ctg_facts_dir }}"
        state: directory

    - name: ctlabs.playbooks.setup.facts_dir.windows
      when: ansible_shell_type | default('sh') == 'powershell'
      win_file:
        path : "{{ ctg_facts_dir }}"
        state: directory

{{PLAYS}}
