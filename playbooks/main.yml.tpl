# ------------------------------------------------------------------------------
# File        : ctlabs-ansible/playbooks/main.yml
# Description : ctlabs phase 4 - run roles (generated by lab.rb)
# ------------------------------------------------------------------------------
# This is the template Controller->Ansible generates main.yml from.
# Edit it directly - it is the single source of truth for everything static.
# The generated role plays (from ansible.play.tags) are spliced in at the
# PLAYS placeholder below on every playbook run; nothing else is touched.
#
# NOTE: unlike a lab, this one does not import up.yml / setup_ctl.yml.
# ctl-sw0 and ctl-ro0 have no SSH authentication set up yet (labs get their
# keys copied during labs-up-container), so waiting for them / writing facts
# on them would just fail. Add the imports back once keys are distributed.
# ------------------------------------------------------------------------------

- import_playbook: up_ctl.yml
- import_playbook: setup_ctl.yml

{{PLAYS}}
