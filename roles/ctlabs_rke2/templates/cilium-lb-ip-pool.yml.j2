{#
 # File        : ctlabs-ansible/roles/ctlabs_rke2/templates/cilium-lb-ip-pool.yml.j2
 # Description : Cilium LB IPAM pool backing native LoadBalancer Services.
 #               Applied (server-only, post-cluster) when cni=cilium,
 #               kube-proxy replacement is on and lb.ip_pool.cidrs is set.
#}
apiVersion: cilium.io/v2alpha1
kind: CiliumLoadBalancerIPPool
metadata:
  name: {{ ctlabs_rke2_cilium_lb_ip_pool_name }}
spec:
  blocks:
{% for cidr in ctlabs_rke2_cilium_lb_ip_pool_cidrs %}
    - cidr: {{ cidr }}
{% endfor %}
