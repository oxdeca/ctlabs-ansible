{#
 # File        : ctlabs-ansible/roles/ctlabs_rke2/templates/facts.json.j2
 # Description : ctlabs_rke2 local facts template
#}
{% set _facts = ctlabs_role_facts | default({}) %}
{
  "role"       : "{{ _facts.role       | default('server') }}",
  "server_url" : "{{ _facts.server_url | default('https://' + CTLABS_HOST + ':9345') }}"
{%- if _facts.server_node is defined %},
  "server_node" : "{{ _facts.server_node }}"
{% endif %}
{% if _facts.ingress is defined %},
  "ingress" : {
    "enabled" : {{ _facts.ingress.enabled | default(false) | lower }},
    "type"    : "{{ _facts.ingress.type | default('nginx') }}"
  }
{% endif %}
{% if _facts.gateway_api is defined %},
  "gateway_api" : {
    "enabled"  : {{ _facts.gateway_api.enabled | default(true) | lower }},
    "provider" : "{{ _facts.gateway_api.provider | default('traefik') }}"
  }
{% endif %}
{% if _facts.servicelb is defined %},
  "servicelb" : {
    "enabled" : {{ _facts.servicelb.enabled | default(false) | lower }}
  }
{% endif %}
{% if _facts.coredns is defined %},
  "coredns" : {
    "resources" : {
      "requests" : {
        "cpu"    : "{{ _facts.coredns.resources.requests.cpu    | default('100m') }}",
        "memory" : "{{ _facts.coredns.resources.requests.memory | default('128Mi') }}"
      },
      "limits" : {
        "cpu"    : "{{ _facts.coredns.resources.limits.cpu    | default('100m') }}",
        "memory" : "{{ _facts.coredns.resources.limits.memory | default('128Mi') }}"
      }
    },
    "split_dns" : {
      "enabled" : {{ _facts.coredns.split_dns.enabled | default(true) | lower }}
{%- if _facts.coredns.split_dns is defined and _facts.coredns.split_dns.domain is defined %},
      "domain" : "{{ _facts.coredns.split_dns.domain }}"
{%- endif %}
{%- if _facts.coredns.split_dns is defined and _facts.coredns.split_dns.nameservers is defined %},
      "nameservers" : {{ _facts.coredns.split_dns.nameservers | to_json }}
{%- endif %}
    }
  }
{% endif %}
}
