[Unit]
Description=rke2 server
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple

User=root

{% set _flags = [] %}
{% if not (ctlabs_rke2_ingress_enabled and ctlabs_rke2_ingress_type == "nginx") %}
{% set _ = _flags.append('--disable=rke2-ingress-nginx') %}
{% endif %}
{% if ctlabs_rke2_servicelb_enabled | default(false) %}
{% set _ = _flags.append('--enable-servicelb') %}
{% endif %}
ExecStart={{ ctlabs_rke2.defaults.pkgs.rke2.path }} server{{ ' ' ~ _flags | join(' ') if _flags }}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
