[Unit]
Description=rke2 control plane
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple

User=root
EnvironmentFile=/etc/sysconfig/rke2
{% set _flags = [] %}
{% if ctlabs_rke2_cni | default('canal') != 'canal' %}
{% set _ = _flags.append('--cni=' + ctlabs_rke2_cni) %}
{% endif %}
ExecStart={{ ctlabs_rke2.defaults.pkgs.rke2.path }} server{{ ' ' ~ _flags | join(' ') if _flags }}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
