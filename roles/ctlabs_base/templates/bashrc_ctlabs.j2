# ------------------------------------------------------------------------------
# File        : ctlabs-ansible/roles/ctlabs_base/templates/bashrc_ctlabs.sh.j2
# Description : aliases and functions used by ctlabs
# ------------------------------------------------------------------------------

if [ -f "/usr/bin/vim" ]; then
  alias vi="/usr/bin/vim"
fi

if [ -d "~/virtenv" ]; then
  alias pva=". ~/virtenv/bin/activate"
  alias pve="deactivate"
fi

function enter() {
  docker exec -it -w ~/ ${1} bash
}
