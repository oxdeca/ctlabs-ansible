# -------------------------------------------------------------------------------------
# File        : ctlabs-ansible/roles/ctlabs_base/templates/facts.ps1.j2
# Description : ctlabs_base role facts (Windows) - declarative per host
# -------------------------------------------------------------------------------------
{#
 # Sourced from the ctlabs `ctlabs_base` setup profile, e.g.
 #   ctlabs_base:
 #     dc1:
 #       disks:
 #         - disk_number : 1
 #           drive_letter: D
 #           fstype      : NTFS
 #           name        : data
 #
 # Declarative per host (role var -> local fact); there are no metadata-server
 # lookups here. Windows facts must be a .ps1 whose stdout is JSON
 # (ConvertTo-Json) - read back as `ansible_ctlabs_base` then from_json in
 # ctg_facts.
 #}
{% set _base = (play_setup | default({}))['base'] | default({}) %}
{% set _f = ctlabs_role_facts | default(_base[inventory_hostname] | default(_base)) %}
$ProgressPreference = 'SilentlyContinue'
$ErrorActionPreference = 'Stop'

$f = @{
    disks = @(
{% for d in _f.disks | default([]) %}
        @{
            device = "{{ d.device | default('') }}"
            path   = "{{ d.path   | default('') }}"
            fstype = "{{ d.fstype | default('') }}"
{%   if d.opts is defined %}
            opts   = "{{ d.opts }}"
{%   endif %}
{%   if d.disk_number is defined %}
            disk_number = {{ d.disk_number }}
{%   endif %}
{%   if d.drive_letter is defined %}
            drive_letter = "{{ d.drive_letter }}"
{%   endif %}
{%   if d.name is defined %}
            name   = "{{ d.name }}"
{%   endif %}
        }
{%   if not loop.last %}
        ,
{%   endif %}
{% endfor %}
    )
}

$f | ConvertTo-Json -Compress
