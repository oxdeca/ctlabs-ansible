{#
 # File        : ctlabs-ansible/roles/ctlabs_argoapp/templates/facts.json.j2
 # Description : ctlabs_argoapp local facts template
 #
 # Forwards only the knobs that were actually set for this host, so an absent
 # key falls through to the role default in precheck.yml. Writing a default
 # here (e.g. "" for kubeconfig) would SHADOW that fallback - an empty string
 # is a defined value, so precheck's `| default(...)` would never kick in.
 #
 # Assembled as one expression rather than a {% for %}: ansible's templar does
 # not carry `set` out of a loop body, which silently drops every forwarded key.
#}
{% set _facts = ctlabs_role_facts | default({}) %}
{% set _knobs = ['namespace', 'kubeconfig', 'interpreter', 'project', 'server', 'wait', 'wait_timeout', 'crd_wait', 'sync_policy', 'finalizers', 'repositories', 'transient_errors'] %}
{{ _facts | dict2items | selectattr('key', 'in', _knobs) | items2dict | combine({'applications': _facts.applications | default([])}) | to_nice_json(indent = 2) }}
