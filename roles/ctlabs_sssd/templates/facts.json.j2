{#
 # File        : ctlabs-ansible/roles/ctlabs_sssd/templates/facts.json.j2
 # Description : ctlabs_sssd local facts template
#}
{% set _facts = ctlabs_role_facts | default({}) %}
{
  "uri"     : "{{ _facts.uri      | default(ctlabs_sssd.defaults.config.ldap.uri) }}",
  "domain"  : "{{ _facts.domain   | default('ad.ctlabs.internal') }}",
  "base"    : "{{ _facts.base     | default('dc=' + (_facts.domain | default('ad.ctlabs.internal')).split('.') | join(',dc=')) }}",
  "backend" : "{{ (_facts.backend | default('ldap')) | upper }}"
}
