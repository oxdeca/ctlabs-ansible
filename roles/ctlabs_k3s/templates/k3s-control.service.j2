[Unit]
Description=k3s control plane
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple

User=root
EnvironmentFile=/etc/sysconfig/k3s
{% set _flags = [] %}
{% if ctlabs_k3s_cni | default('flannel') == 'cilium' %}
{% set _ = _flags.append('--flannel-backend=none') %}
{% set _ = _flags.append('--disable-network-policy') %}
{% endif %}
ExecStart={{ ctlabs_k3s.defaults.pkgs.k3s.path }} server{{ ' ' ~ _flags | join(' ') if _flags }}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
