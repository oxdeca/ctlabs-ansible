{#
 # File        : ctlabs-ansible/roles/ctlabs_ca/templates/facts.json.j2
 # Description : ctlabs_ca local facts template
 #}
{% set _host_facts = ctlabs_role_facts | default({}) %}
{% set _role_facts = (play_setup | default({}))['ca'] | default({}) %}
{% set _san = _host_facts.san | default(_role_facts.san | default([])) %}
{% set _san = [_san] if _san is string else _san %}
{
  "domain" : "{{ _host_facts.domain | default(_role_facts.domain | default(CTLABS_DOMAIN | default(ctlabs_ca.defaults.config.domain))) }}"
{% if _san | length > 0 %},
  "san"    : {{ _san | to_json }}
{% endif %}
}
