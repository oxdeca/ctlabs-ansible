#{# /etc/openvpn/server/server.conf #}

dev          {{ ctg_facts.ctlabs_openvpn.dev | default('tun0') }}
persist-tun 

proto        {{ ctg_facts.ctlabs_openvpn.proto | default('udp') }}
port         {{ ctg_facts.ctlabs_openvpn.port | default(1194) }}
ifconfig     {{ ctg_facts.ctlabs_openvpn.server_ip }} {{ ctg_facts.ctlabs_openvpn.client_ip }}

secret       ovpn.key
auth         {{ ctg_facts.ctlabs_openvpn.auth | default('SHA512') }}
auth-nocache

cipher       {{ ctg_facts.ctlabs_openvpn.cipher | default('AES-256-CBC') }}
keepalive    10 60 
verb         3
