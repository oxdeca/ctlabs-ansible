# ------------------------------------------------------------------------------
# File        : ctlabs-ansible/roles/ctlabs_aide/templates/aide-check.service.j2
# Description : systemd unit for periodic AIDE integrity check
# ------------------------------------------------------------------------------

[Unit]
Description=AIDE integrity check
Documentation=man:aide(1)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart={{ ctlabs_aide.defaults.script }}

[Install]
WantedBy=multi-user.target
