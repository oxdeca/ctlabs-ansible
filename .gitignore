.ctlabs_*
__pycache__

# Ignore all Graphify outputs (including cache, HTML, and reports)
graphify-out/*

# Explicitly whitelist ONLY the core AI context file
!graphify-out/graph.json

# generated by lab.rb — do not commit
playbooks/setup.yml
.play_setup.json
playbooks/.play_setup*.json
.play_setup*.json

# generated runtime files & inventories
dnsmasq.d/
inventories/*.ini
invnetories/controller

# generated playbooks (all except static ones)
playbooks/*.yml
!playbooks/up.yml
!playbooks/up_ctl.yml
!playbooks/init.yml

# python cache
roles/__pycache__/
roles/*/filter_plugins/__pycache__/
