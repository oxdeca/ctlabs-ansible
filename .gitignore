.ctlabs_*
__pycache__

# Ignore all Graphify outputs (including cache, HTML, and reports)
graphify-out/*

# Explicitly whitelist ONLY the core AI context file
!graphify-out/graph.json

# generated by lab.rb — do not commit
playbooks/setup.yml
.play_setup.json

# generated playbooks (all except static ones)
playbooks/*.yml
!playbooks/up.yml
!playbooks/init.yml

# python cache
roles/__pycache__/
roles/*/filter_plugins/__pycache__/
